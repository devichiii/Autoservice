# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=replace-me

# База backend API (v1)
API_BASE_URL=http://localhost:3000/api/v1

# Тот же секрет, что TELEGRAM_BOT_API_KEY на стороне NestJS (заголовок x-telegram-api-key)
TELEGRAM_BOT_API_KEY=replace-with-telegram-internal-secret

# Куда слать уведомления (числовой chat_id, например личка или группа)
TELEGRAM_NOTIFY_CHAT_ID=replace-with-chat-id

# Опционально: интервал опроса pending (секунды)
# TELEGRAM_PENDING_POLL_SECONDS=10

# Опционально: лимит за один запрос (1..100, по умолчанию 20)
# TELEGRAM_PENDING_LIMIT=20

# По умолчанию httpx НЕ подхватывает системные прокси для вызовов API (см. README).
# Если backend только через корпоративный прокси: HTTPX_TRUST_ENV=true

# Прокси только для исходящих запросов aiogram к api.telegram.org (long polling, sendMessage).
# Если без прокси Telegram недоступен, укажите URL (часто socks5://127.0.0.1:1080 — см. ваш клиент).
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# (Опционально код также читает устаревшее имя TELEGRAM_PROXY_URL — лучше использовать TELEGRAM_PROXY.)
